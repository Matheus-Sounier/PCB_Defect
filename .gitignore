*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment / secrets
.env
.env.* 

# Test / coverage caches
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Type checkers / caches
.mypy_cache/
.dmypy.json

# IDEs / editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

